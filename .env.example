# Copy to .env and replace deployment secrets locally. Never commit real secrets.
APP_TIMEZONE=Africa/Tripoli
DATABASE_URL=mysql+pymysql://attendance_app:CHANGE_ME@127.0.0.1:3306/attendance_face_system
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
# Set a password before running python -m scripts.create_admin.
ADMIN_PASSWORD=

# Attendance matching policy. Earlier or post-shift check-ins are unscheduled.
ATTENDANCE_EARLY_CHECK_IN_WINDOW_MINUTES=60
ATTENDANCE_PROCESSING_DELAY_MINUTES=30
MISSING_CHECKOUT_DELAY_MINUTES=240
ATTENDANCE_AUTO_PROCESSING_ENABLED=True
ATTENDANCE_AUTO_PROCESSING_INTERVAL_SECONDS=60
ATTENDANCE_AUTO_PROCESSING_LOOKBACK_DAYS=7

FACE_DETECTOR_BACKEND=mtcnn
FACE_EMBEDDER_BACKEND=facenet
# Optional offline PAD evaluation. It is not enforced by current live attendance.
FACE_ANTI_SPOOF_MODEL_PATH=./storage/models/anti_spoof/anti-spoof-mn3.onnx
FACE_ANTI_SPOOF_MODEL_NAME=openvino-anti-spoof-mn3-onnx
FACE_ANTI_SPOOF_MODEL_SHA384=6de4534964b723397b3e8c995cadcf43bc007cc2f9930b95ae25f76adccece5d1d4d058d0b15117b9e4a9f758424f92a
FACE_ANTI_SPOOF_CALIBRATION_PATH=./storage/models/anti_spoof/local-calibration.json
FACE_ANTI_SPOOF_SAMPLE_FRAMES=8
FACE_ANTI_SPOOF_MIN_VALID_FRAMES=4
FACE_SECURITY_DEBUG=False

# The kiosk reads MOBILE_CAMERA_SOURCE first and retains STREAM_URL compatibility.
MOBILE_CAMERA_SOURCE=0
MOBILE_CAMERA_STREAM_URL=http://127.0.0.1:8080/video
LIVE_ATTENDANCE_API_BASE_URL=http://127.0.0.1:55000
LIVE_LIVENESS_HARDENED_MODE=False
